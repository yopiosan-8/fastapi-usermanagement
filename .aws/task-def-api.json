{
    "containerDefinitions": [
        {
            "name": "watanabe-fastapi",
            "image": "<image uri>",
            "cpu": 0,
            "portMappings": [
                {
                    "containerPort": 8000,
                    "hostPort": 8000,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "environment": [],
            "mountPoints": [],
            "volumesFrom": [],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/watanabe-fastapi",
                    "awslogs-region": "ap-northeast-1",
                    "awslogs-stream-prefix": "fastapi"
                }
            },
            "systemControls": []
        }
    ],
    "family": "watanabe-fastapi",
    "taskRoleArn": "watanabe-fastapi-ecs-task-role",
    "executionRoleArn": "watanabe-fastapi-execution-role",
    "networkMode": "awsvpc",
    "volumes": [],
    "placementConstraints": [],
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "256",
    "memory": "512"
}